<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Azmy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsUsageDescription</key>
	<string>Azmy needs access to your calendar to help you plan your day, create events, and provide scheduling insights.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Azmy needs full calendar access to create, edit, and manage your events. This allows the AI assistant to schedule meetings and optimize your daily routine.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Azmy needs to add events to your calendar.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Azmy uses your health data to provide personalized insights about your sleep, activity, and energy patterns to help optimize your daily routine.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Azmy can save your wellness data to help track your progress.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Azmy needs microphone access to enable voice commands. Speak naturally to control your calendar, ask questions, and interact with your AI assistant hands-free.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Azmy uses your location to show local weather, suggest nearby places, and provide location-aware recommendations.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Azmy uses your location to show local weather, suggest nearby places, and provide location-aware reminders even when the app is in background.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Azmy uses speech recognition to convert your voice into text for processing by the AI assistant.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google Sign-In</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.185785334554-i8n1ih7d6l763vteof9t8kro9r83rapo</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
